APP_NAME=Frontech Innovations Logistics Platform
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Use postgresql+asyncpg for the application connection.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/frontech
REDIS_URL=redis://localhost:6379/0

# Generate a unique value for staging and production. Do not commit actual secrets.
JWT_SECRET=change-me-in-a-secure-secret-manager
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Run `python -m app.db.bootstrap` once after Alembic migrations to create the
# first platform administrator. Leave blank after bootstrap is complete.
BOOTSTRAP_SUPER_ADMIN_NAME=Frontech Super Admin
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=ChangeThisBootstrapPassword123!

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
LOG_LEVEL=INFO

# Private S3-compatible object storage placeholders.
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_BUCKET=frontech-private
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
